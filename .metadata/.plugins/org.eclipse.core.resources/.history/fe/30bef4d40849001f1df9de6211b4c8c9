package Day2_practise;

public class Looping_cls {

	public static void main(String[] args) {
		
	int i=1;
		// TODO Auto-generated method stub
     while(i<=10)
     {
    	 if(i%2==1) {
    	 System.out.println(i+"odd");
    	
     }
    	 else
    		 System.out.println(i+"even");
    	 
    	 
	} i++;
     }}


